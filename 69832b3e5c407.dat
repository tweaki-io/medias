                                <textarea  class="form-textarea mt-1.5 w-full resize-none rounded-lg border border-slate-300 bg-transparent p-2.5 placeholder:text-slate-400/70 hover:border-slate-400 focus:border-primary dark:border-navy-450 dark:hover:border-navy-400 dark:focus:border-accent placeholder:text-slate-400/70" wire:model="addon_description" placeholder="Enter Description">
</textarea>

