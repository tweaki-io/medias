    <input   x-on:remove-images.window="FilePond.removeFiles();" type="file"
        x-init="() => {
            $el._x_filepondx = FilePond.create($el, {
                allowMultiple: false,
                maxFiles: 4,
                files: [
                                    ],
            });
            $el._x_filepondx.setOptions({
                server: {
                                        process: (fieldName, file, metadata, load, error, progress, abort, transfer, options) => {
                        window.livewire.find('S36wwhWF3S984yo4gkAS').upload('addon_image', file, load, error, progress)
                    },
                    revert: (filename, load, error) => {
                        window.livewire.find('S36wwhWF3S984yo4gkAS').removeUpload('addon_image', filename, load)
                    },
                                    },

            });
            this.addEventListener('pondReset', e => {
                $el._x_filepondx.removeFiles();
            });

            this.addEventListener('pondEdit', e => {
                $el._x_filepondx.removeFiles();
                if (e.detail) {
                    $el._x_filepondx.addFile(e.detail);
                }
            });

        }" />
</div>


